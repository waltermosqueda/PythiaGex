<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PythiaGexTres</AssemblyName>
    <RootNamespace>PythiaGexTres</RootNamespace>
    <Version>3.0.0</Version>
    <Company>PythiaGex</Company>
    <Product>PythiaGex 3.0</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Lista explicita: lo que no esta aca no se compila. -->
  <ItemGroup>
    <Compile Include="Black76.cs" />
    <Compile Include="CadenaApi.cs" />
    <Compile Include="Centinela.cs" />
    <Compile Include="Feed.cs" />
    <Compile Include="GammaHoyNucleo.cs" />
    <Compile Include="GammaHoyTres.cs" />
    <Compile Include="GammaHoyTresMemoria.cs" />
    <Compile Include="GammaHoyTresCapas.cs" />
    <Compile Include="GammaHoyTresHisteresis.cs" />
    <Compile Include="GammaHoyTresCaja.cs" />
    <Compile Include="GammaHoyTresCinta.cs" />
    <Compile Include="GammaHoyTresApoyo.cs" />
    <Compile Include="GammaHoyTresRayas.cs" />
    <Compile Include="GammaHoyTresRecuadro.cs" />
    <Compile Include="GammaHoyTresFormula.cs" />
    <Compile Include="GammaHoyTresMajorOi.cs" />
    <Compile Include="GammaHoyTresAtravesadas.cs" />
    <Compile Include="GammaHoyTresTunel.cs" />
    <Compile Include="GammaHoyTresEstado.cs" />
    <Compile Include="Registro.cs" />
    <Compile Include="RelojNy.cs" />
    <Compile Include="SondaApi.cs" />
    <Compile Include="Viva3.cs" />
    <!-- 3.7.0: la seleccion sin ATAS (la compila tambien atas/_propuesta_3_7/Simulador37) y la cola del indicador -->
    <Compile Include="Seleccion37.cs" />
    <Compile Include="Conversion37.cs" />
    <Compile Include="Dibujo37.cs" />
    <Compile Include="GammaHoyTres37.cs" />
  </ItemGroup>

  <!-- Los ensamblados de ATAS no se copian: la plataforma ya los tiene cargados.
       Copiarlos haria que el indicador use una copia distinta de los mismos
       tipos y ATAS lo rechazaria al cargarlo. Igual que en 2.0, mas
       OFT.Platform.Core (ahi vive OptionsSubscriptionService, la pieza publica
       de la API de opciones de 8.0.15). -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.Types">
      <HintPath>C:\Program Files (x86)\ATAS Platform\ATAS.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Localization">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>C:\Program Files (x86)\ATAS Platform\Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Core">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Platform.Core">
      <HintPath>C:\Program Files (x86)\ATAS Platform\OFT.Platform.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
