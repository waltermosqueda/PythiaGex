    <RootNamespace>PythiaGexCinco</RootNamespace>
    <Version>5.0.2.0</Version>
    <!-- 5.0.1 (27-10-2026): AssemblyVersion FIJA en 5.0.0.0 (como la 4.1 con 4.0.0.0: el .ws guarda el tipo con su Version=); la version
         real va en FileVersion / InformationalVersion. -->
    <AssemblyVersion>5.0.0.0</AssemblyVersion>
    <FileVersion>5.0.2.0</FileVersion>
    <InformationalVersion>5.0.2</InformationalVersion>
    <Company>PythiaGex</Company>
    <Product>PythiaGex 5.0 - Gamma ES</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
