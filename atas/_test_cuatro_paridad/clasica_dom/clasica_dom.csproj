<Project Sdk="Microsoft.NET.Sdk">
  <!-- Arnes clasica_dom (PythiaGex 4.1.5b, 09-10-2026): las dominantes D1-D3 de la capa NDX de la clasica (R10_NDX_dom "Clasica NDX", DominantesClasica en
       _modulos/familia/clasica/ClasicaNdx.cs) contra (A) lo que guardo la 4.1.5b en niv-*.jsonl, (B) el port Python verificado y los AUDIT capa=NDX de la
       clasica del 09-10 con base 243,06, y (C) casos borde con cadenas sinteticas. Datos REALES de solo lectura: se copian a %TEMP%\pg4_clasica_dom.
       Compila los .cs de produccion desde su lugar (la misma lista que el arnes clasica). El exe corre ref_dominantes.py (python -I -B) en el medio.
       Uso: dotnet build -c Release -o bin/Release ; bin/Release/clasica_dom.exe -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>clasica_dom</AssemblyName>
    <RootNamespace>PruebaClasicaDom</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../PythiaGexCuatro/_contratos/Contratos.cs" Link="m/Contratos.cs" />
    <Compile Include="../../PythiaGexCuatro/AdaptadoresFamilia.cs" Link="m/AdaptadoresFamilia.cs" />
    <Compile Include="../../PythiaGexCuatro/_modulos/cboe/*.cs" LinkBase="m/cboe" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/comun/*.cs" LinkBase="m/comun" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/fam/*.cs" LinkBase="m/fam" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/ndx/*.cs" LinkBase="m/ndx" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/qqq/*.cs" LinkBase="m/qqq" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/replica20/*.cs" LinkBase="m/replica20" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/clasica/*.cs" LinkBase="m/clasica" />
    <Compile Include="../../PythiaGexCuatro/_modulos/familia/posiciones/*.cs" LinkBase="m/posiciones" />
    <Compile Include="../../PythiaGexCuatro/_modulos/tqqq/TqqqPerfil.cs" Link="m/tqqq/TqqqPerfil.cs" />
    <Compile Include="../../PythiaGexCuatro/_modulos/tqqq/TqqqSesion.cs" Link="m/tqqq/TqqqSesion.cs" />
    <Compile Include="../../PythiaGexCuatro/_modulos/tqqq/TqqqUtil.cs" Link="m/tqqq/TqqqUtil.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
