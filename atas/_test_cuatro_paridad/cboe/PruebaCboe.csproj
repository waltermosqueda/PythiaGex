<Project Sdk="Microsoft.NET.Sdk">
  <!-- Arnes del modulo cboe (B2) de PythiaGex 4.1: compila los MISMOS .cs del modulo (sin copias) + los contratos, sin ATAS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../PythiaGexCuatro/_contratos/Contratos.cs" Link="modulo/Contratos.cs" />
    <Compile Include="../../PythiaGexCuatro/_modulos/cboe/*.cs" Link="modulo/%(Filename)%(Extension)" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
