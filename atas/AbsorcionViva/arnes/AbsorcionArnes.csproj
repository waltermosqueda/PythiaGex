<Project Sdk="Microsoft.NET.Sdk">

  <!-- EL ARNES DE PARIDAD: consola, SIN ninguna referencia a ATAS. Compila el MISMO
       AbsorcionNucleo.cs que va adentro del indicador, para que lo que se compara contra el
       Python sea exactamente el codigo que corre en el grafico. Molde ya probado:
       atas/PatronOperador/arnes/PatronArnes.csproj (ronda 9, 20.610 senales, 100 %). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AbsorcionArnes</AssemblyName>
    <RootNamespace>AbsorcionArnes</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\AbsorcionNucleo.cs" Link="AbsorcionNucleo.cs" />
  </ItemGroup>

</Project>
