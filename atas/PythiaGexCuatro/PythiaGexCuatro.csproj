<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PythiaGexCuatro</AssemblyName>
    <RootNamespace>PythiaGexCuatro</RootNamespace>
    <Version>4.1.4</Version>
    <!-- 4.1 (B1): AssemblyVersion FIJA en 4.0.0.0. El .ws del operador guarda el tipo como
         "PythiaGexCuatro.FamiliaCuatro, PythiaGexCuatro, Version=4.0.0.0": asi el grafico del visor 4.0.6
         carga la 4.1 sin volver a agregarla (SIN VERIFICAR en ATAS). La version real va en FileVersion/InformationalVersion. -->
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>4.1.4.0</FileVersion>
    <InformationalVersion>4.1.4</InformationalVersion>
    <Company>PythiaGex</Company>
    <Product>PythiaGex 4.0 - Gamma Familia</Product>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
  </PropertyGroup>

