# el crudo de CBOE es pesado y se puede volver a bajar: no va al repo
datos/cache/
# la salida intermedia tampoco; lo que se publica esta en panel/
datos/salida/

# el historico SI va: es lo que habilita lookbacks e intradia
!datos/historico/
atas/*/obj/
atas/*/bin/Debug/
atas/_api/bin/
atas/_test/bin/
atas/_test/obj/
atas/PythiaVwap/bin/
atas/PythiaVwap/obj/

# copias para Pages de datos/historico/cadena-*.jsonl.gz: se publican, no se commitean dos veces
panel/datos/atas/cadenas/

# descargas de Databento: pesan decenas de MB, viven fuera de git
datos/databento/
datos/historico/cadena-*
panel/_prueba/

# busqueda del gatillo: caches pesados (la cinta cruda vive en %APPDATA%/ATAS/PythiaGex/flujo)
